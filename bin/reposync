#!/bin/sh
#
# reposync - git repository synchronization driven by REPOSYNC_* env vars
# (C) 2026 Atarwn Gard <atarwn@qwaderton.org>
# inspired by autils by emmett1
# MIT License
#

LOGFILE=/var/log/reposync.log

log() {
	if [ "$LOG" ]; then
		printf '%s %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$1" | tee -a "$LOGFILE"
	else
		printf '%s\n' "$1"
	fi
}

run_cmd() {
	if [ "$DRY_RUN" ]; then
		log " [dry-run] $*"
	else
		log " $*"
		"$@"
	fi
}

syncrepo() {
	_url=$1
	_branch=$2
	_path=$3

	[ -z "$_url" ] && return 0
	if [ -z "$_path" ]; then
		log "error: invalid repo format (missing path)"
		return 1
	fi

	if [ "$FORCE" ] && [ -d "$_path" ]; then
		log "=> force removing $_path"
		run_cmd rm -rf "$_path"
	fi

	if [ ! -d "$_path/.git" ]; then
		log "=> cloning $_url into $_path"
		if [ "$DRY_RUN" ]; then
			log " [dry-run] git clone --quiet --branch $_branch --single-branch $_url $_path"
		else
			mkdir -p "$_path" || return 1
			git clone --quiet --branch "$_branch" --single-branch "$_url" "$_path"
		fi
	else
		log "=> updating $_path"
		_old=$(git -C "$_path" rev-parse HEAD 2>/dev/null) || _old=
		run_cmd git -C "$_path" fetch --quiet origin "$_branch" || return 1
		run_cmd git -C "$_path" reset --quiet --hard "origin/$_branch" || return 1
		run_cmd git -C "$_path" clean -q -fdx
		_new=$(git -C "$_path" rev-parse HEAD 2>/dev/null) || _new=
		if [ "$_old" ] && [ "$_new" ] && [ "$_old" != "$_new" ]; then
			log "=> changed files:"
			git -C "$_path" --no-pager diff --stat "$_old" "$_new" 2>/dev/null || true
		fi
	fi
}

usage() {
	printf 'usage: %s [-n|-l|-f]\n' "${0##*/}"
	printf ' -n  dry-run\n -l  logging (%s)\n -f  force sync\n' "$LOGFILE"
	exit 1
}

while [ "$1" ]; do
	case "$1" in
		-n) DRY_RUN=1 ;;
		-l) LOG=1 ;;
		-f) FORCE=1 ;;
		-h) usage ;;
	esac
	shift
done

command -v git >/dev/null 2>&1 || {
	printf '%s\n' "error: git is not installed." >&2
	exit 1
}

REPOS=$(env | grep '^REPOSYNC_' | sort || true)

if [ -z "$REPOS" ]; then
	printf '%s\n' "error: no REPOSYNC_* variables found." >&2
	exit 1
fi

printf '%s\n' "$REPOS" | while IFS='=' read -r _name _value; do
	IFS='|' read -r _url _branch _path _rest << EOF
$_value
EOF
	[ -z "$_url" ] && continue
	syncrepo "$_url" "$_branch" "$_path"
done

exit 0
