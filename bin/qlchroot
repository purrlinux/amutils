#!/bin/sh
#
# qlchroot - enter a chroot with virtual filesystems mounted
# (C) 2026 Atarwn Gard <atarwn@qwaderton.org>
# MIT License
#

KEEP=

usage() {
    printf 'usage: %s [-k] <chroot-dir> [command [args...]]\n' "${0##*/}"
    printf '  -k  keep mounts after exit\n'
    printf '  -h  show this help\n'
}

err() {
    printf 'qlchroot: %s\n' "$*" >&2
}

die() {
    err "$*"
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -k)
            KEEP=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            usage >&2
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[ "$(id -u)" = 0 ] || die "root access required"
[ "$#" -ge 1 ] || {
    usage >&2
    die "chroot directory required"
}

TARGET=$(realpath "$1") || die "cannot resolve chroot directory"
[ -d "$TARGET" ] || die "directory '$TARGET' does not exist"
[ "$TARGET" != / ] || die "refusing to chroot into /"

shift

if [ "$#" -eq 0 ]; then
    set -- /bin/sh
fi

ENV=$(command -v env) || die "env not found"
CHROOT=$(command -v chroot) || die "chroot not found"

command -v mountpoint >/dev/null 2>&1 ||
    die "mountpoint not found"

# Mount state
M_DEV=0
M_PROC=0
M_SYS=0
M_EFIVARS=0
M_RUN=0

RESOLV_ACTIVE=0
RESOLV_SAVED=0
RESOLV_BACKUP="$TARGET/etc/.resolv.conf.qlchroot.$$"

READY=0

umount_one() {
    path=$1
    mounted=$2

    if [ "$mounted" = 1 ]; then
        if ! umount "$path"; then
            err "warning: could not unmount $path"
        fi
    fi
}

cleanup() {
    status=$?

    trap - 0 HUP INT TERM

    if [ "$RESOLV_ACTIVE" = 1 ]; then
        rm -f "$TARGET/etc/resolv.conf"

        if [ "$RESOLV_SAVED" = 1 ]; then
            mv "$RESOLV_BACKUP" "$TARGET/etc/resolv.conf" ||
                err "warning: could not restore resolv.conf"
        fi
    fi

    if [ -z "$KEEP" ] || [ "$READY" != 1 ]; then
        umount_one "$TARGET/run" "$M_RUN"
        umount_one "$TARGET/sys/firmware/efi/efivars" "$M_EFIVARS"
        umount_one "$TARGET/sys" "$M_SYS"
        umount_one "$TARGET/proc" "$M_PROC"
        umount_one "$TARGET/dev" "$M_DEV"
    fi

    exit "$status"
}

# Check mountpoints before changing anything.
for path in \
    "$TARGET/dev" \
    "$TARGET/proc" \
    "$TARGET/sys" \
    "$TARGET/run" \
    "$TARGET/sys/firmware/efi/efivars"
do
    if [ -e "$path" ] && mountpoint -q "$path"; then
        die "$path is already mounted"
    fi
done

# Prepare mountpoint directories.
mkdir -p \
    "$TARGET/dev" \
    "$TARGET/proc" \
    "$TARGET/sys" \
    "$TARGET/run" ||
    die "cannot create mountpoint directories"

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# /dev
mount --bind /dev "$TARGET/dev" ||
    die "cannot bind /dev"
M_DEV=1

# /proc
mount -t proc proc "$TARGET/proc" ||
    die "cannot mount proc"
M_PROC=1

# /sys
mount -t sysfs sysfs "$TARGET/sys" ||
    die "cannot mount sysfs"
M_SYS=1

# EFI variables
if [ -d /sys/firmware/efi/efivars ] &&
   [ -d "$TARGET/sys/firmware/efi/efivars" ]; then
    mount --bind /sys/firmware/efi/efivars \
        "$TARGET/sys/firmware/efi/efivars" ||
        die "cannot bind efivars"
    M_EFIVARS=1
fi

# /run
mount -t tmpfs tmpfs "$TARGET/run" \
    -o mode=755,nosuid,nodev ||
    die "cannot mount /run"
M_RUN=1

# Restore /dev/shm target if it is a symlink.
if [ -L "$TARGET/dev/shm" ]; then
    SHM_TARGET=$(readlink "$TARGET/dev/shm") ||
        die "cannot read /dev/shm symlink"

    case "$SHM_TARGET" in
        /*) mkdir -p "$TARGET$SHM_TARGET" ;;
        *)  mkdir -p "$TARGET/dev/$SHM_TARGET" ;;
    esac || die "cannot create /dev/shm target"
fi

# Provide host DNS configuration.
if [ -f /etc/resolv.conf ]; then
    if [ -e "$TARGET/etc/resolv.conf" ] ||
       [ -L "$TARGET/etc/resolv.conf" ]; then
        mv "$TARGET/etc/resolv.conf" "$RESOLV_BACKUP" ||
            die "cannot save resolv.conf"
        RESOLV_SAVED=1
    fi

    RESOLV_ACTIVE=1

    cp -L /etc/resolv.conf "$TARGET/etc/resolv.conf" ||
        die "cannot copy resolv.conf"
fi

READY=1

# Execute env on the host, not inside chroot.
"$ENV" -i \
    HOME=/root \
    TERM="${TERM:-linux}" \
    PS1='\u:\w\$ ' \
    PATH=/bin:/usr/bin:/sbin:/usr/sbin \
    "$CHROOT" "$TARGET" "$@"

retval=$?
exit "$retval"

